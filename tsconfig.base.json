{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@capex-lens/shared": ["packages/shared/src/index.ts"],
      "@capex-lens/indicators": ["packages/indicators/src/index.ts"],
      "@capex-lens/providers": ["packages/providers/src/index.ts"],
      "@capex-lens/db": ["packages/db/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true
  }
}
